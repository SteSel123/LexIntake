# Copy to .env and fill in secrets. Never commit real API keys.

OPENAI_API_KEY=

LEXINTAKE_EMBEDDING_PROVIDER=openai
LEXINTAKE_EMBEDDING_MODEL=text-embedding-3-small
LEXINTAKE_EMBEDDING_DIMS=1536

LEXINTAKE_LLM_PROVIDER=openai
LEXINTAKE_LLM_MODEL=gpt-4.1

# Agno Monitoring (native OpenTelemetry traces → monitoring/traces.db)
LEXINTAKE_AGNO_TRACING=1

# Optional providers for evaluation comparison
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Required: PostgreSQL with pgvector + pg_trgm
# Default stack (docker compose up): Compose sets host to "postgres" inside containers
# Host Python against DB only: keep localhost below and run: docker compose up -d postgres
DATABASE_URL=postgresql://lexintake:lexintake@localhost:5432/lexintake

# Deploy (optional)
# Comma-separated browser origins for the Vercel frontend, or * (default)
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Public API base URL injected into the static Vercel UI at build time
# LEXINTAKE_API_URL=https://lexintake-api.onrender.com
